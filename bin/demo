#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${BASE_URL:-http://localhost:3000}"
DEMO_TARGET="${DEMO_TARGET:-local}"

cd "$(dirname "$0")/.."

banner() {
  printf '\n==== %s ====\n' "$1"
}

banner "1/4 Reset and seed (${DEMO_TARGET})"
case "$DEMO_TARGET" in
  local) bin/rails db:seed:replant ;;
  docker) docker compose exec -T web bin/rails db:seed:replant ;;
  *) echo "DEMO_TARGET must be local or docker, got: ${DEMO_TARGET}" >&2; exit 1 ;;
esac

banner "2/4 Health check ${BASE_URL}/health/ready"
if ! curl -fsS "${BASE_URL}/health/ready"; then
  echo >&2
  echo "API is not ready at ${BASE_URL}. Start it with bin/dev or docker compose up, then run bin/demo again." >&2
  exit 1
fi
echo

banner "3/4 API sequence (make api-check)"
make api-check BASE_URL="${BASE_URL}"

banner "4/4 Concurrency proof (race specs)"
bundle exec rspec spec/concurrency/http_booking_race_spec.rb spec/concurrency/book_overlap_spec.rb --format documentation

banner "Demo complete"
