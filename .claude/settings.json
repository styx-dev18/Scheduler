{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/verify.sh)",
      "Bash(.claude/scripts/verify.sh *)",
      "Bash(bundle exec rspec*)",
      "Bash(bundle exec rubocop*)",
      "Bash(bin/rails zeitwerk:check)",
      "Bash(bin/brakeman*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git merge-base*)",
      "Bash(git ls-files*)",
      "Bash(git branch --show-current)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(curl http://localhost:*)",
      "Write(.claude/plans/**)",
      "Edit(.claude/plans/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr merge*)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)"
    ],
    "deny": [
      "Bash(git commit * --no-verify*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)"
    ]
  }
}
